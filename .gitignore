# ============================================
# .gitignore para MonanaFinancial
# ============================================

# Dependências do Composer
/vendor/

# Configuração sensível
/config/database.php

# Logs
/logs/*.log
/logs/*.txt

# Uploads de utilizadores
/public/uploads/*
!/public/uploads/.gitkeep

# Exportações temporárias
/exports/pdf/*.pdf
/exports/excel/*.xlsx

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Ficheiros temporários
*.tmp
*.temp
*.bak