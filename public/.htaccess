# MonanaFinancial - pasta /public (defesa em profundidade)

Options -Indexes -MultiViews +FollowSymLinks
RewriteEngine On

# Ficheiros e pastas reais (css, js, images, uploads) sao servidos diretamente
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Qualquer outro pedido e encaminhado para index.php como parametro "url"
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
