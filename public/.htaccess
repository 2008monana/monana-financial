RewriteEngine On

# Ficheiros estáticos são servidos diretamente (nunca passam pelo index.php)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Qualquer outro pedido e encaminhado para index.php como parametro "url"
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
