# =====================================================
# MonanaFinancial - Encaminhamento para /public (URLs limpas)
# Ficheiro na RAIZ do projeto (C:\xampp\htdocs\monana-financial\.htaccess)
#
# IMPORTANTE: este ficheiro usa regras RELATIVAS ao diretório onde está
# instalado (funciona em htdocs/monana-financial e em domínio próprio).
# Para aplicar: substitua este ficheiro no XAMPP, REINICIE o Apache e
# faça um hard refresh no navegador (Ctrl+Shift+R).
# =====================================================

Options -Indexes -MultiViews +FollowSymLinks
RewriteEngine On

# =============================================
# 0) PASTAS DE CÓDIGO-FONTE: bloqueio apenas para ACESSO DIRETO.
#    O teste %{REQUEST_FILENAME} -f/-d garante que só pedidos que
#    apontam fisicamente para estas pastas são bloqueados. Assim,
#    a rota "/logs" do sistema NÃO gera mais "403 Forbidden"
#    (antes a pasta física /logs da raiz conflituava com a rota).
# =============================================
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(config|controllers|core|helpers|middleware|models|views|exports|sql|vendor|storage)(/|$) - [F,L]

# =============================================
# 1) REDIRECIONAMENTO EXTERNO: pedidos que ainda mostram /public/
#    na URL (ex.: http://localhost/monana-financial/public/dashboard)
#    passam a usar a estrutura limpa dominio/modulo.
#    %1 = prefixo anterior a "public/" extraído do THE_REQUEST
#    (ex.: /monana-financial); $1 = restante do caminho capturado pela regra.
# =============================================
RewriteCond %{THE_REQUEST} (\S*/)?public/[^\s?]+
RewriteRule ^public/(.*)$ %1$1 [R=302,L]
RewriteCond %{THE_REQUEST} \S*/public/?[\s?]
RewriteRule ^public/?$ %1 [R=302,L]

# =============================================
# 2a) REDIRECIONAMENTO EXTERNO: URLs desatualizadas em cache/botão
#     "voltar" do navegador que ainda apontam para /public/css|js|images|uploads
#     passam a usar a estrutura limpa dominio/modulo.
#     IMPORTANTE: %1 é o prefixo ANTERIOR a "public/" extraído do
#     THE_REQUEST (ex.: /monana-financial); sem ele, o redirect gerava
#     caminhos incorrectos como //css/login.css (404 no CSS/JS da página
#     de login). A regra usa $1/$2 (capturas da própria regra), porque
#     %1 já aponta para o prefixo do projeto.
# =============================================
RewriteCond %{THE_REQUEST} (\S*/)?public/(css|js|images|uploads)/[^\s?]+
RewriteRule ^public/(css|js|images|uploads)/(.*)$ %1$1/$2 [R=302,L]

# =============================================
# 2b) FICHEIROS ESTÁTICOS REAIS (css, js, images, uploads)
#     Ex.: /monana-financial/css/login.css -> /public/css/login.css
#     IMPORTANTE: as regras NÃO dependem de %{DOCUMENT_ROOT}, porque no
#     XAMPP o DOCUMENT_ROOT aponta para htdocs/ e não inclui a subpasta
#     do projeto. Testes de ficheiro usam caminhos RELATIVOS ao diretório
#     deste .htaccess (prefixados com "public"), o que é compatível com
#     qualquer versão do Apache.
# =============================================
#    Regra compacta e sem dependencia de %{DOCUMENT_ROOT}: o caminho do
#    RewriteCond e construido com o prefixo fisico (public) + o URI SEM a
#    barra inicial ( %1%2 ), testando directamente a existencia do ficheiro.
RewriteCond $0 ^(css|js|images|uploads)(/.*)?$
RewriteCond public%1%2 -f [OR]
RewriteCond public%1%2 -d
RewriteRule ^(css|js|images|uploads)(/.*)?$ public/$1$2 [L]

# Fallback generico: qualquer outro ficheiro/pasta real dentro de /public
# (ex.: favicon.ico na raiz do projeto -> public/favicon.ico)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond public$1 -f [OR]
RewriteCond public$1 -d
RewriteRule ^(.+)$ public/$1 [L]

# =============================================
# 3) PEDIDOS COM EXTENSÃO DE FICHEIRO (.php, .html, etc.)
#    que não são ficheiros estáticos reais -> 404
#    (impede acesso direto a index.php, config.php, etc.)
# =============================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} \.[a-zA-Z0-9]{1,6}(/|$)
RewriteRule .* - [R=404,L]

# =============================================
# 4) URLs LIMPAS: tudo o resto cai em public/index.php
#    (o Router trata os acessos proibidos a pastas de código-fonte,
#     devolvendo 404 — nunca "Forbidden")
# =============================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php?url=$1 [QSA,L]
