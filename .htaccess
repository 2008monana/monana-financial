# =====================================================
# MonanaFinancial - Encaminhamento para /public (URLs limpas)
# Coloque este ficheiro na RAIZ do projeto
# (C:\xampp\htdocs\monana-financial\.htaccess)
# =====================================================

# Bloqueia acesso direto a pastas sensíveis
RewriteEngine On
RewriteRule ^(config|controllers|core|database|exports|helpers|logs|middleware|models|storage|vendor|views)(/|$) - [F,L]

# =============================================
# URLs LIMPAS: qualquer pedido com nome de ficheiro
# (index.php, algo.html, etc.) fora da estrutura
# dominio/modulo/acao -> resposta 404
# =============================================
RewriteCond %{REQUEST_URI} (\.[a-zA-Z0-9]{1,6})(/|$)
RewriteRule .* - [R=404,L]

# Impede o acesso direto via /public/... no navegador (redireciona para URL limpa)
RewriteCond %{THE_REQUEST} \s/public/(index\.php)?[?\s]
RewriteRule ^public/?$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/public/(\S+?)\.php[?\s]
RewriteRule ^ - [R=404,L]

# Se o pedido não apontar para /public, encaminha para public/index.php
RewriteCond %{REQUEST_URI} !^/?public/
RewriteRule ^(.*)$ public/index.php?url=$1 [QSA,L]

# Se apontar para /public/algum-ficheiro-inexistente, também cai no index
RewriteCond %{REQUEST_URI} ^/?public/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^public/(.*)$ public/index.php?url=$1 [QSA,L]
