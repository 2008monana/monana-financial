# =====================================================
# MonanaFinancial - Encaminhamento para /public (URLs limpas)
# Ficheiro na RAIZ do projeto (C:\xampp\htdocs\monana-financial\.htaccess)
#
# CORRECAO DEFINITIVA DO "403 FORBIDDEN" EM /logs (Auditoria):
#   O modulo de Auditoria usa a rota dinamica /logs, que tem o MESMO
#   nome da pasta fisica logs/ criada por instalacoes antigas (tanto na
#   raiz como dentro de public/). Nessas situacoes o Apache entrava na
#   directoria ANTES de correr as regras mod_rewrite e devolvia
#   "403 Forbidden" ao clicar no link do sidebar.
#   SOLUCAO ADOPTADA:
#     1) As rotas com colisão de nomes (/logs e /backups) são SEMPRE
#        reencaminhadas para o front controller logo no inicio deste
#        ficheiro — nunca chegam a ser resolvidas como pastas físicas.
#     2) Os registos reais de log passaram a ser gravados em
#        storage/logs/ (fora do alcance das rotas), protegida pelo seu
#        proprio .htaccess ("Require all denied").
#     3) Qualquer pedido directo a uma PASTA de codigo-fonte existente
#        (logs/, config/, views/, ...) recebe agora a pagina 404 do
#        sistema em vez de "403 Forbidden" — nem um ambiente antigo
#        com pastas residuais volta a mostrar esse erro.
#
# Para aplicar: substitua ESTE ficheiro e tambem public/.htaccess,
# REINICIE o Apache e faca hard refresh (Ctrl+Shift+R).
# =====================================================

Options +FollowSymLinks
RewriteEngine On

# =============================================
# 1) ROTAS DINAMICAS QUE COLIDEM COM PASTAS FISICAS:
#    /logs (Auditoria) => LogsController e /backups => BackupsController.
#    Estas regras correm ANTES de qualquer resolucao de directoria e
#    enviam o pedido diretamente ao front controller, com ou sem
#    prefixo de subpasta (funciona em htdocs/monana-financial/logs
#    e em dominio/logs).
# =============================================
RewriteRule ^(?:[^/]+/)?logs(/.*)?$ public/index.php?url=logs$1 [QSA,L]
RewriteRule ^(?:[^/]+/)?backups(/.*)?$ public/index.php?url=backups$1 [QSA,L]

# =============================================
# 2) QUALQUER PEDIDO A UMA PASTA FISICA DE CODIGO-FONTE OU DE DADOS
#    (existentes ou legados: logs/, config/, views/, core/, storage/...)
#    vai para o front controller, que responde com a pagina 404 do
#    sistema. Isto elimina definitivamente o "403 Forbidden" mesmo em
#    instalacoes com pastas residuais de versoes anteriores.
# =============================================
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(config|controllers|core|helpers|middleware|models|views|database|sql|cron|exports|storage|vendor|logs)(/|$) public/index.php?url=$1$2 [QSA,L]

# =============================================
# 2b) FICHEIROS SENSIVEIS DAS PASTAS ACIMA (.php, .sql, .log...):
#     tambem viram 404 em vez de 403/execucao directa.
# =============================================
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(config|controllers|core|helpers|middleware|models|views|database|sql|cron|logs|storage|vendor)(/|$) public/index.php?url=$1$2 [QSA,L]

# =============================================
# 3) URLS DESACTUALIZADAS COM /public/ NA BARRA DE ENDERECO
#    voltam a estrutura limpa (dominio/modulo).
#    Ex.: /monana-financial/public/dashboard -> /monana-financial/dashboard
# =============================================
RewriteCond %{THE_REQUEST} ^[A-Z]+\s\S*/public/[^\s?]+
RewriteRule ^(.*)public/(.+)$ $1$2 [R=302,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s\S*/public/?[\s?]
RewriteRule ^(.*)public/?$ $1/ [R=302,L]

# =============================================
# 4) CREDENCIAIS NUNCA NA URL: se o formulario for enviado por
#    GET (?email=...&senha=...), limpa a URL e volta ao login.
# =============================================
RewriteCond %{QUERY_STRING} (^|&)(email|senha)= [NC]
RewriteRule ^auth(/login)?$ auth? [R=302,L,QSD]

# =============================================
# 5) FICHEIROS ESTATICOS (css, js, images, uploads, favicon):
#    reescrita INTERNA para dentro de public/, usando as capturas
#    da propria regra. Se o ficheiro nao existir, a seccao 6 ainda
#    o envia para o front controller (404 HTML normal).
# =============================================
RewriteRule ^(?:[^/]+/)?(css|js|images|uploads)/(.+)$ public/$1/$2 [L]
RewriteRule ^(?:[^/]+/)?favicon\.ico$ public/favicon.ico [L]

# =============================================
# 6) TUDO O RESTO -> front controller (URLs limpas).
# =============================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ public/index.php?url=$1 [QSA,L]
