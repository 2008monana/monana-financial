# =====================================================
# MonanaFinancial - Encaminhamento para /public (URLs limpas)
# Ficheiro na RAIZ do projeto (C:\xampp\htdocs\monana-financial\.htaccess)
# =====================================================

Options -Indexes -MultiViews
RewriteEngine On

# =============================================
# 1) FICHEIROS ESTÁTICOS REAIS em /public
#    (css, js, images, fonts, uploads) são SERVIDOS diretamente.
#    Ex.: /monana-financial/css/login.css -> /monana-financial/public/css/login.css
#    A regra funciona tanto na raiz de htdocs como em subpastas.
# =============================================
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-f [OR]
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-d
RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
RewriteRule ^(.+)$ public/$1 [L]

# =============================================
# 2) PEDIDOS COM EXTENSÃO DE FICHEIRO (.php, .html, etc.)
#    que não são ficheiros estáticos reais -> 404
#    (impede acesso direto a index.php, config.php, etc.)
# =============================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} \.[a-zA-Z0-9]{1,6}(/|$)
RewriteRule .* - [R=404,L]

# =============================================
# 3) BLOQUEIO de pastas sensíveis do código-fonte
# =============================================
RewriteRule ^(config|controllers|core|database|exports|helpers|middleware|models|storage|vendor|views)(/|$) - [F,L]

# =============================================
# 4) URLs LIMPAS: tudo o resto cai em public/index.php
# =============================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php?url=$1 [QSA,L]
