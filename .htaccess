# =====================================================
# MonanaFinancial - Encaminhamento para /public (URLs limpas)
# Ficheiro na RAIZ do projeto (C:\xampp\htdocs\monana-financial\.htaccess)
#
# ESTRATEGIA:
#   - Os ficheiros ESTATICOS reais vivem em public/ e sao servidos por
#     reescrita INTERNA directa (sem testes de existencia com capturas
#     vazias %1/%2, sem redirecionamentos externos em cadeia e sem
#     regras que possam provocar ciclos). As capturas $1/$2 da propria
#     RewriteRule sao usadas no destino - o que e sempre valido.
#   - As ROTAS dinamicas (/auth, /dashboard, ...) caem no front
#     controller public/index.php.
#   - Funciona instalado em htdocs/monana-financial OU em dominio proprio.
# Para aplicar: substitua este ficheiro, REINICIE o Apache e faca
# hard refresh no navegador (Ctrl+Shift+R).
# =====================================================

Options -Indexes +FollowSymLinks
RewriteEngine On

# =============================================
# 1) PASTAS DE CODIGO-FONTE: acesso directo proibido
#    (apenas quando o pedido aponta fisicamente para elas).
# =============================================
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(config|controllers|core|helpers|middleware|models|views|database|sql|exports|storage)(/|$) - [F,L]

# =============================================
# 2) URLS DESACTUALIZADAS COM /public/ NA BARRA DE ENDERECO
#    voltam a estrutura limpa (dominio/modulo).
#    Ex.: /monana-financial/public/dashboard -> /monana-financial/dashboard
# =============================================
RewriteCond %{THE_REQUEST} ^[A-Z]+\s\S*/public/[^\s?]+
RewriteRule ^(.*)public/(.+)$ $1$2 [R=302,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s\S*/public/?[\s?]
RewriteRule ^(.*)public/?$ $1/ [R=302,L]

# =============================================
# 3) CREDENCIAIS NUNCA NA URL: se o formulario for enviado por
#    GET (?email=...&senha=...), limpa a URL e volta ao login.
# =============================================
RewriteCond %{QUERY_STRING} (^|&)(email|senha)= [NC]
RewriteRule ^auth(/login)?$ auth? [R=302,L,QSD]

# =============================================
# 4) FICHEIROS ESTATICOS (css, js, images, uploads, favicon):
#    reescrita INTERNA para dentro de public/, usando as capturas
#    da propria regra. Se o ficheiro nao existir, a seccao 5 ainda
#    o envia para o front controller (que devolve 404 HTML normal),
#    mas os caminhos abaixo correspondem aos ficheiros reais do repo.
# =============================================
RewriteRule ^(?:[^/]+/)?(css|js|images|uploads)/(.+)$ public/$1/$2 [L]
RewriteRule ^(?:[^/]+/)?favicon\.ico$ public/favicon.ico [L]

# =============================================
# 5) TUDO O RESTO -> front controller (URLs limpas).
# =============================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php?url=$1 [QSA,L]
